{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: create venv + pip install",
      "type": "shell",
      "command": "python3 -m venv .venv && . .venv/bin/activate && pip install -U pip && pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "Train ML models",
      "type": "shell",
      "command": ". .venv/bin/activate && PYTHONPATH=. python scripts/train_models.py",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Setup: create venv + pip install"]
    },
    {
      "label": "Run API (8742)",
      "type": "shell",
      "command": ". .venv/bin/activate && PYTHONPATH=. python -m uvicorn app.main:app --host 127.0.0.1 --port 8742 --reload",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "pytest",
      "type": "shell",
      "command": ". .venv/bin/activate && PYTHONPATH=. python -m pytest tests/ -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
